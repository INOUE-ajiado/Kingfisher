rules_version = '2';

// ラッシュルーム (src/engine/rushService.ts) の規則。
//
// ⚠️ access/{鍵} の一覧 (list) を許さないこと。鍵はルーム ID と合言葉のハッシュで、
// 鍵を知っていること = 合言葉を知っていること、という前提で守っている。
// 一覧を許すと、合言葉を知らなくても動画の URL とリテイクへ辿り着ける。
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@ajiado[.]co[.]jp$');
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function roomOf(roomId) {
      return get(/databases/$(database)/documents/rushRooms/$(roomId)).data;
    }

    function isOperatorOf(room) {
      return room.hostEmail == myEmail() || myEmail() in room.operatorEmails;
    }

    match /rushRooms/{roomId} {
      allow read: if isStaff();

      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(
             ['id', 'roomName', 'hostEmail', 'operatorEmails', 'createdAt', 'lastActiveAt', 'isLive'])
        && request.resource.data.id == roomId
        && request.resource.data.hostEmail == myEmail()
        && request.resource.data.operatorEmails is list
        && request.resource.data.roomName is string
        && request.resource.data.roomName.size() > 0
        && request.resource.data.roomName.size() <= 200;

      // オペレーターが変えてよいのは、オペレーターの一覧と LIVE と最終アクティブ時間だけ
      allow update: if isStaff()
        && isOperatorOf(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['operatorEmails', 'isLive', 'lastActiveAt'])
        && request.resource.data.operatorEmails is list
        && request.resource.data.isLive is bool;

      allow delete: if isStaff() && isOperatorOf(resource.data);

      match /access/{accessKey} {
        allow get: if isStaff();
        allow list: if false;
        allow create: if isStaff() && roomOf(roomId).hostEmail == myEmail();
        allow update, delete: if isStaff() && isOperatorOf(roomOf(roomId));

        match /retakes/{retakeId} {
          allow read: if isStaff();
          allow create, update: if isStaff()
            && isOperatorOf(roomOf(roomId))
            && exists(/databases/$(database)/documents/rushRooms/$(roomId)/access/$(accessKey))
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 5000;
          allow delete: if isStaff() && isOperatorOf(roomOf(roomId));
        }
      }
    }

    // ホストの再生状態。視聴者 (社外の人を含む) が追従する。
    // ID は推測できない乱数で、ルームの access 文書か外部共有の access 文書からしか辿れない
    match /rushPlayback/{playbackId} {
      allow get: if true;
      allow list: if false;
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['roomId', 'playing', 'position', 'live', 'updatedAt'])
        && isOperatorOf(roomOf(request.resource.data.roomId));
      allow update: if isStaff()
        && isOperatorOf(roomOf(resource.data.roomId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playing', 'position', 'live', 'updatedAt'])
        && request.resource.data.playing is bool
        && request.resource.data.position is number
        && request.resource.data.live is bool;
      allow delete: if isStaff() && isOperatorOf(roomOf(resource.data.roomId));
    }

    // 外部共有 (src/engine/rushShareService.ts)。社外の人はログインしていない (request.auth == null)。
    //
    // ⚠️ 一覧 (list) を許さないこと。共有 ID を知っていること = URL を受け取ったこと、が入口の条件。
    match /rushShares/{shareId} {
      function shareData() {
        return get(/databases/$(database)/documents/rushShares/$(shareId)).data;
      }
      function shareOpen() {
        let s = shareData();
        return s.revoked == false && request.time.toMillis() < s.expiresAt;
      }
      function isShareOperator() {
        return isStaff() && isOperatorOf(roomOf(shareData().roomId));
      }

      // ⚠️ URL を知っていれば誰でも読める。入力画面に出すもの以外を置かせないこと
      //    (発行した人のメールアドレスは合言葉の内側の access 文書に置く)
      allow get: if true;
      allow list: if false;
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['id', 'roomId', 'roomName', 'createdAt', 'expiresAt', 'revoked'])
        && request.resource.data.id == shareId
        && request.resource.data.revoked == false
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt <= request.time.toMillis() + 30 * 24 * 60 * 60 * 1000
        && isOperatorOf(roomOf(request.resource.data.roomId));
      // 止める (revoked) だけ。期限を延ばすことはさせない
      allow update: if isStaff()
        && isOperatorOf(roomOf(resource.data.roomId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
        && request.resource.data.revoked == true;
      allow delete: if isStaff() && isOperatorOf(roomOf(resource.data.roomId));

      // 視聴者。名乗るのは関数だけ (合言葉の照合と試行回数の制限をサーバーで行うため)。
      // 視聴者にできるのは、自分の在席の合図を送ることだけ
      match /viewers/{viewerId} {
        allow create: if false;
        allow update: if shareOpen()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
          && request.resource.data.lastSeenAt is number;
        // 視聴者どうしで名前が見えないよう、一覧はオペレーターだけ
        allow read: if isShareOperator();
        allow delete: if isShareOperator();
      }
    }

    // 合言葉のハッシュと動画の在りか。
    // ⚠️ 読ませないこと。読めると、合言葉を知らなくても動画へ辿り着ける。
    // 発行と後始末はオペレーターができるが、中身はサーバー (Cloud Functions) だけが読む。
    match /rushShareSecrets/{shareId} {
      allow read: if false;
      allow create: if isStaff()
        && isOperatorOf(roomOf(request.resource.data.roomId))
        && request.resource.data.keys().hasOnly(['roomId', 'passwordHash', 'videoPath', 'playbackId', 'createdByEmail', 'createdAt'])
        && request.resource.data.passwordHash is string;
      allow update, delete: if isStaff() && isOperatorOf(roomOf(resource.data.roomId));
    }

    // 合言葉の試行回数。サーバーだけが触る
    match /rushShareAttempts/{shareId} {
      allow read, write: if false;
    }

    // 削除の記録。書き込むだけで、画面からは読まない
    match /rushRoomDeleteLogs/{logId} {
      allow create: if isStaff() && request.resource.data.deletedByEmail == myEmail();
    }
  }
}
